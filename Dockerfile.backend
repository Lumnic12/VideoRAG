# ─── Stage 1: Build the C++ ssim_fast extension ──────────────────────────────
FROM python:3.12-slim AS cpp-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY cpp_bindings/ ./cpp_bindings/
COPY backend/requirements.txt ./

WORKDIR /build/cpp_bindings
RUN python setup_c.py build_ext --inplace || echo "[WARN] C build failed — using Python fallback"
RUN touch ssim_fast_dummy.so


# ─── Stage 2: Python dependency cache ────────────────────────────────────────
FROM python:3.12-slim AS py-deps

WORKDIR /app
COPY backend/requirements.txt .

# Install core deps
RUN pip install --no-cache-dir -r requirements.txt

# faster-whisper: works fine on Linux
RUN pip install --no-cache-dir faster-whisper

# winocr uses WinRT — Windows only. Skip gracefully on Linux.
# vlm_service.py has try/except ImportError so Tesseract OCR is used as fallback.
RUN pip install --no-cache-dir winocr \
    || echo "[INFO] winocr not available on Linux — OCR will use Tesseract fallback"


# ─── Stage 3: Final production image ─────────────────────────────────────────
FROM python:3.12-slim AS final

LABEL org.opencontainers.image.title="Semantic Video Synthesizer — Backend"
LABEL org.opencontainers.image.description="FastAPI + Celery: SSIM keyframes -> OCR -> Whisper -> FAISS RAG -> Ollama LLM"

# Runtime deps: ffmpeg for audio extraction, tesseract for OCR fallback (when winocr unavailable)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libglib2.0-0 \
        tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN groupadd --gid 1001 svs && \
    useradd --uid 1001 --gid svs --no-create-home svs

WORKDIR /app

# Copy Python packages
COPY --from=py-deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=py-deps /usr/local/bin /usr/local/bin

# Copy C extension (if build succeeded)
COPY --from=cpp-builder /build/cpp_bindings/ssim_fast*.so /app/services/

# Copy application source
COPY backend/ .

# Create data directories
RUN mkdir -p data/uploads data/keyframes data/faiss_index && \
    chown -R svs:svs /app

USER svs

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
