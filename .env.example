# .env.example — Semantic Video Synthesizer
# Copy to .env: cp .env.example .env
# NEVER commit .env to git!

# ══════════════════════════════════════════════════════════════════════════════
# REQUIRED — Local AI Services (Ollama)
# ══════════════════════════════════════════════════════════════════════════════

# Ollama must be running: ollama serve
# Required models: ollama pull gemma3:1b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma3:1b
OLLAMA_VISION_MODEL=moondream

# ══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Cloud API Keys (not required for basic functionality)
# ══════════════════════════════════════════════════════════════════════════════

# Deepgram (cloud transcription fallback — Whisper is used locally by default)
# DEEPGRAM_API_KEY=

# Google Gemini (optional LLM/Vision fallback)
# GEMINI_API_KEY=

# Groq (optional fast cloud LLM)
# GROQ_API_KEY=

# OpenRouter (optional LLM fallback)  
# OPENROUTER_API_KEY=

# HuggingFace (optional VLM fallback)
# HF_API_TOKEN=

# ══════════════════════════════════════════════════════════════════════════════
# Infrastructure
# ══════════════════════════════════════════════════════════════════════════════

# Local dev:  redis://localhost:6379/0
# Docker:     redis://redis:6379/0  (auto-set in docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# ══════════════════════════════════════════════════════════════════════════════
# Storage Paths (auto-set in Docker via docker-compose.yml)
# ══════════════════════════════════════════════════════════════════════════════
UPLOAD_DIR=./data/uploads
KEYFRAME_DIR=./data/keyframes
FAISS_INDEX_PATH=./data/faiss_index

# ══════════════════════════════════════════════════════════════════════════════
# Pipeline Tuning
# ══════════════════════════════════════════════════════════════════════════════
MAX_UPLOAD_SIZE_MB=500
SSIM_THRESHOLD=0.95
