# .env.example — copy to .env and fill in real values
# NEVER commit .env to git — it is already in .gitignore

# ── AI / ML API Keys ─────────────────────────────────────────────────────────
# Required for real embeddings + RAG answers
OPENAI_API_KEY=sk-...

# Required for real transcription (Deepgram nova-2)
DEEPGRAM_API_KEY=...

# Required for real VLM analysis (Jina-VLM via HuggingFace)
HF_API_TOKEN=hf_...

# ── Infrastructure ────────────────────────────────────────────────────────────
# Local dev:   redis://localhost:6379/0
# Docker:      redis://redis:6379/0   (service name resolves inside compose network)
REDIS_URL=redis://localhost:6379/0

# ── Storage Paths ─────────────────────────────────────────────────────────────
# Local dev (relative to backend/):
UPLOAD_DIR=./data/uploads
KEYFRAME_DIR=./data/keyframes
FAISS_INDEX_PATH=./data/faiss_index

# Docker (absolute inside container — set in docker-compose.yml environment block,
# these values are overridden there so you don't need to change them here for Docker):
# UPLOAD_DIR=/app/data/uploads
# KEYFRAME_DIR=/app/data/keyframes
# FAISS_INDEX_PATH=/app/data/faiss_index

# ── Pipeline Tuning ───────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
SSIM_THRESHOLD=0.95

# ── Feature Flags ─────────────────────────────────────────────────────────────
# (reserved for future use)
# EMBED_MODEL=all-MiniLM-L6-v2
